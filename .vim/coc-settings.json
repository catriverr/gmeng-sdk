{
    "clangd.enabled": true,
    "clangd.fallbackFlags": [
        "-std=c++23",
        "-I${workspaceFolder}/include",
        "-I${workspaceFolder}/include/imgui",
        "-I${workspaceFolder}/include/asio",
        "-Wno-format-security",
        "-Wno-mixed-indent",
        "-D_THREAD_SAFE",
        "-L/opt/homebrew/lib",
        "-I/opt/homebrew/include/SDL2",
        "-I/opt/homebrew/include/lua",
        "-I/opt/homebrew/include",
        "-lSDL2",
        "-llua",
        "-DNCURSES_WIDECHAR",
        "-I/opt/homebrew/Cellar/ncurses/6.5/include/ncursesw",
        "-I/opt/homebrew/Cellar/ncurses/6.5/include",
        "-I/opt/homebrew/",
        "-Wno-writable-strings",
        "-Linclude",
        "-Iinclude",
        "-I./include",
        "-Iinclude/",
        "-Iinclude/imgui",
        "-Iinclude/asio",
        "-Linclude/asio",
        "-DGMENG_SDL=false"
    ],
    "clangd.arguments": [
        "--background-index=true"
    ]
}
